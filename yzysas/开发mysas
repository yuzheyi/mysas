comps结构体适用于n个进出口，（存储进出口质量流量m1~mn）
struct comp
    int CompId // 组件ID唯一索引号
    // 组件类型（0：定常组件，1：零维非定常元件（容腔效应），2：一维元件，3：耦合元件）
    int CompType

    if (CompType == 0) // 定常组件
    {
        steadyVariable // 定常变量（只保留最新的一个时间步数据）
    }
    else if (CompType == 1) // 零维非定常元件（容腔效应）
    {
        unsteadyVariable[n] // 非定常变量(n为时间步，一般保留最近的4个时间步的数据)
    }
    else if (CompType == 2) // 一维元件
    {
        /* code */
    }
    else if (CompType == 3) // 耦合元件
    {
        /* code */
    }
    
struct 一维元件
    /* code */

struct unsteadyVariable
    double controlVolume // 控制体体积（容积效应）
    double controlMass // 控制体流体质量（一般由今进出口净通量差以及控制体体积决定）
    double averageTotalTemperature;  // 组件平均流体总温（average total temperature）
    double averageStaticTemperature; // 组件平均流体静温（average static temperature）
    double averageTotalPressure;     // 组件平均流体总压（average total pressure）
    double averageStaticPressure;    // 组件平均流体静压（average static pressure）
    double averageDensity;           // 组件平均流体密度（average density）
    Interface[n]    // 组件进出口流量信息（n为进出口个数）

struct steadyVariable
    Interface[n]    // 组件进出口流量信息（n为进出口个数）

struct interface
    double massFlow; // 进出口质量流量（mass flow）
    double staticPressure; // 进出口静压力（static pressure）
    double staticTemperature; // 进出口静温度（static temperature）
    double totalTemperature; // 进出口总温度（total temperature）
    double totalPressure; // 进出口总压力（total pressure）
    double machNumber; // 进出口马赫数
    double area; // 进出口面积
    int connectedNodeId; // 连接到的节点ID

node结构体存储总温（TT），总压（TP）
struct node
 TT; // 总温（total temperature）
 TP; // 总压（total pressure）
